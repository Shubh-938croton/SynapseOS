# ==============================================================================
# SynapseOS Frontend Environment Configuration Template
# Copy this file to .env or configure in Vercel Project Settings.
# ==============================================================================

# Backend API Base URL (Point to your deployed Render web service URL)
# Example for production: https://synapseos-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (Must match backend GOOGLE_CLIENT_ID for token exchange)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
