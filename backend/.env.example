# ==============================================================================
# SynapseOS Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# ==========================================
# 1. SERVER & RUNTIME CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=5000

# Allowed CORS Origins (comma-separated for multiple domains)
# Example for production: https://synapseos.vercel.app,https://app.synapseos.com
CORS_ORIGIN=http://localhost:5173

# ==========================================
# 2. DATABASE CONFIGURATION (MySQL / Aiven)
# ==========================================
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your_aiven_mysql_password_here
DB_NAME=synapseos

# Aiven SSL Certificate Configuration (Recommended for production)
# Option A: Paste full PEM certificate contents inline (newlines will be handled)
DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Option B: Path to downloaded ca.pem file
# DB_SSL_CA_PATH=/path/to/ca.pem

# ==========================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==========================================
# Generate a strong 64-byte secret (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_ultra_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Client ID (Backend Token Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ==========================================
# 4. EXTERNAL INTEGRATIONS
# ==========================================
# YouTube Data API v3 Key (for Study Hub video search)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ==========================================
# 5. AUTOMATION & SCHEDULED INTELLIGENCE (Phase 4)
# ==========================================
AUTOMATION_ENABLED=true
AUTOMATION_TIMEZONE=Asia/Kolkata

# ==========================================
# 6. AI INTELLIGENCE LAYER (Phase 5 & 6)
# ==========================================
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000

# Google Gemini API Key (Required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
